# Banco. Vazio = PGlite local em ./.pglite (só para desenvolvimento).
# Em produção: connection string do Neon (postgresql://...?sslmode=require)
DATABASE_URL=

# Better Auth: gere com `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# URL pública do core (ex.: https://cardapios-core.vercel.app). Local: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Vercel Blob (fotos). Criado automaticamente ao conectar um Blob store ao projeto na Vercel.
BLOB_READ_WRITE_TOKEN=

# Opcional: sal para o hash de IP no limite de envios (padrão: BETTER_AUTH_SECRET)
IP_HASH_SALT=
