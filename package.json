    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "test": "tsx --test tests/*.test.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@vercel/blob": "^2.9.0",
